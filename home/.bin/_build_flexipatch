#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 1 ]] || { echo "Usage: _build_flexipatch <dwm|st|dmenu|slock>" >&2; exit 2; }
case $1 in dwm|st|dmenu|slock) ;; *) echo "Unknown flexipatch: $1" >&2; exit 2 ;; esac
script=$(readlink -f -- "${BASH_SOURCE[0]}")
repo=$(cd -- "$(dirname -- "$script")/../.." && pwd)
if [[ $(id -u) -eq 0 ]]; then
    exec bash "$repo/setup/build-flexipatch.sh" "$1"
fi
exec sudo -- bash "$repo/setup/build-flexipatch.sh" "$1"
